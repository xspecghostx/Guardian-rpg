{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardian",
  "main": "index.js",
  "compatibility_date": "2026-09-25",
  "placement": {
    "region": "aws:ap-southeast-2"
  },
  "vars": {
    "SUPABASE_URL": "https://qvlacvadzogeosfqxwfo.supabase.co",
    "DEFAULT_CAMPAIGN_SLUG": "grimdark_riven_dask_420342"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPAIGN_RUNTIME",
        "class_name": "CampaignRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CampaignRuntime"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
